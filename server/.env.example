# ---------------------------------------------------------------------------
# AI Document Analysis App - server environment variables
# Copy this file to ".env" and fill in the values you need.
# Never commit your real .env file.
# ---------------------------------------------------------------------------

# Port the Express API server listens on (local/traditional server only -
# Vercel manages this itself and ignores it).
PORT=4000

# Origin of the frontend dev server, used for CORS + cookies. Leave unset in
# production on Vercel (client and API share an origin there via rewrites,
# so CORS doesn't apply) - the server falls back to reflecting the request
# origin when this isn't set.
CLIENT_ORIGIN=http://localhost:5173

# Postgres connection string. Required everywhere (dev, tests use an
# in-memory substitute automatically, and production). Get a free one from
# https://neon.tech, https://vercel.com/storage/postgres, or any Postgres
# provider. Typically looks like:
#   postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Anthropic API key used for question answering and document summarization.
# If this is left empty, the app automatically runs in DEMO MODE:
#   - Chat answers are built directly from the most relevant retrieved
#     passages instead of a generated response.
#   - Summaries are a basic extractive preview instead of an AI summary.
# This lets you fully exercise upload -> processing -> chat -> citations
# without any external API key. Set a real key to get real AI answers.
ANTHROPIC_API_KEY=

# Claude model used for answering questions and summarizing documents.
AI_MODEL=claude-sonnet-5

# Vercel Blob read/write token, used to store uploaded PDFs when deployed to
# Vercel (its serverless functions have no persistent local filesystem).
# Leave empty for local dev / a traditional server deployment - PDFs are
# then stored on local disk instead (see UPLOAD_DIR below). Get one by
# adding a Blob store to your Vercel project (Storage tab); Vercel sets this
# automatically for you once it's attached.
BLOB_READ_WRITE_TOKEN=

# Directory where uploaded PDFs are stored on disk (isolated per user id).
# Only used when BLOB_READ_WRITE_TOKEN is not set.
UPLOAD_DIR=./uploads

# Maximum size (in MB) accepted per uploaded PDF file.
MAX_FILE_SIZE_MB=20
